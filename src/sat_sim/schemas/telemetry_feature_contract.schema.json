{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.telemetry-feature-contract.v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "fault_id",
    "mechanism_id",
    "status",
    "telemetry_profile",
    "raw_features",
    "derived_features",
    "label_policy",
    "split_policy",
    "missing_data_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-sim.telemetry-feature-contract.v1"
    },
    "contract_id": {
      "type": "string"
    },
    "fault_id": {
      "type": "string"
    },
    "mechanism_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active_provisional",
        "blocked_pending_basilisk_fault_migration"
      ]
    },
    "telemetry_profile": {
      "type": "string"
    },
    "raw_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "channel",
          "unit",
          "dtype",
          "evidence_role",
          "model_input_eligible",
          "rationale",
          "availability",
          "required_for_formal_model_input"
        ],
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "dtype": {
            "type": "string"
          },
          "evidence_role": {
            "enum": [
              "observable_telemetry",
              "operational_estimate",
              "simulator_truth"
            ]
          },
          "model_input_eligible": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "available",
              "missing_from_simulator",
              "missing_from_astrograph"
            ]
          },
          "required_for_formal_model_input": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "derived_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "inputs",
          "transformation",
          "leakage_safe",
          "model_input_eligible",
          "status"
        ],
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "transformation": {
            "type": "string"
          },
          "leakage_safe": {
            "type": "boolean"
          },
          "model_input_eligible": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "provisional",
              "blocked_missing_channel",
              "approved"
            ]
          },
          "unit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "label_policy": {
      "type": "object"
    },
    "split_policy": {
      "type": "object"
    },
    "missing_data_policy": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
