{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.astrograph-diagnostic-mapping-bundle.v1",
  "type": "object",
  "required": [
    "schema_version",
    "mapping_count",
    "fault_ids",
    "mappings",
    "governance",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-sim.astrograph-diagnostic-mapping-bundle.v1"
    },
    "mapping_count": {
      "type": "integer",
      "minimum": 1
    },
    "fault_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "governance": {
      "type": "object"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_contract": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
