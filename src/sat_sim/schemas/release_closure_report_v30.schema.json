        "level": {
          "title": "Level",
          "type": "string"
        },
        "expected_validation": {
          "title": "Expected Validation",
          "type": "string"
        },
        "run_status": {
          "title": "Run Status",
          "type": "string"
        },
        "validation_result": {
          "title": "Validation Result",
