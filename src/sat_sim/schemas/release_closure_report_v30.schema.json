    "RepresentativeSuiteReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "v28.representative-suite.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "generated_at_utc": {
          "title": "Generated At Utc",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
