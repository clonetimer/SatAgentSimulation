{
  "$defs": {
    "AttemptStatus": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "ExecutionFailure": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "failure_class": {
          "title": "Failure Class",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "exception_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception Type"
        },
        "traceback_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceback File"
        }
      },
      "required": [
        "reason_code",
        "failure_class",
        "message",
        "retryable"
      ],
      "title": "ExecutionFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "v25.execution-attempt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/AttemptStatus"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "elapsed_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Seconds"
    },
    "plan_sha256": {
      "title": "Plan Sha256",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    }
  },
  "required": [
    "attempt_id",
    "sequence",
    "status",
    "started_at",
    "plan_sha256"
  ],
  "title": "Satellite Simulation ExecutionAttempt V25",
  "type": "object",
  "$id": "https://example.local/sat-sim/execution-attempt-v25.schema.json"
}
