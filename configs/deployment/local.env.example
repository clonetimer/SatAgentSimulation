# 既有版本 control plane. Copy to a protected environment file and replace values.
SAT_SIM_AUTH_MODE=token
SAT_SIM_AUTH_TOKENS_FILE=/etc/sat-sim/auth.json
SAT_SIM_AUDIT_LOG=/var/lib/sat-sim/audit/api_audit.jsonl
SAT_SIM_TRUSTED_HOSTS=sim.example.internal,127.0.0.1,localhost
SAT_SIM_RUNS_ROOT=/var/lib/sat-sim/runs
SAT_SIM_API_ARTIFACTS_ROOT=/var/lib/sat-sim/control
SAT_SIM_QUEUE_DATABASE=/var/lib/sat-sim/control/execution_queue.sqlite3
SAT_SIM_EMBEDDED_WORKER=0
SAT_SIM_MAX_REQUEST_BYTES=16777216
SAT_SIM_REMOTE_UPLOAD_MAX_BYTES=1073741824

# Secrets must come from a secret manager or protected environment file.
SAT_SIM_ADMIN_TOKEN=replace-me
SAT_SIM_OPERATOR_TOKEN=replace-me
SAT_SIM_VIEWER_TOKEN=replace-me
SAT_SIM_WORKER_01_TOKEN=replace-me

# Optional real model providers. Unconfigured providers receive no score.
# DEEPSEEK_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# SAT_SIM_MODEL_PROVIDERS_FILE=/etc/sat-sim/model_providers.json
