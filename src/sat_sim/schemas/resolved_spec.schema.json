          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "dependency"
          ],
          "title": "Role",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "public_adapter": {
          "title": "Public Adapter",
          "type": "string"
