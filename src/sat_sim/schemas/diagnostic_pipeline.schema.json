{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.diagnostic-pipeline.v1",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_id",
    "fault_id",
    "mechanism_id",
    "feature_contract_id",
    "status",
    "stages",
    "model_policy",
    "expert_review_required",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-sim.diagnostic-pipeline.v1"
    },
    "pipeline_id": {
      "type": "string"
    },
    "fault_id": {
      "type": "string"
    },
    "mechanism_id": {
      "type": "string"
    },
    "feature_contract_id": {
      "type": "string"
    },
    "diagnostic_signature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active_provisional",
        "blocked_pending_basilisk_fault_migration"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "kind",
          "implementation_ref",
          "required",
          "input_refs",
          "output_ref"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "data_quality_gate",
              "signature_detector",
              "feature_extractor",
              "ml_model",
              "kg_reasoner",
              "simulation_evidence",
              "fusion",
              "expert_review_gate"
            ]
          },
          "implementation_ref": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "model_policy": {
      "type": "object",
      "required": [
        "candidate_model_families",
        "binding_status",
        "selection_gate"
      ],
      "properties": {
        "candidate_model_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding_status": {
          "enum": [
            "disabled_pending_benchmark",
            "blocked_by_simulation_capability",
            "enabled"
          ]
        },
        "selection_gate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "expert_review_required": {
      "type": "boolean"
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
