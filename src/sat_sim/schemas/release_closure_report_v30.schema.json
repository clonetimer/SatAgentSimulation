      "type": "string"
    },
    "release_version": {
      "default": "0.3.0",
      "title": "Release Version",
      "type": "string"
    },
    "generated_at_utc": {
      "title": "Generated At Utc",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "environment_doctor": {
      "$ref": "#/$defs/EnvironmentDoctorReport"
