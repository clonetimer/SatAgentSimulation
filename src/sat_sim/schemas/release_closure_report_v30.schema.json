  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "v30.release-closure-report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "release_id": {
      "default": "V30-DUPLICATE-DEFINITION-AND-DEAD-CODE-CLOSURE-1",
