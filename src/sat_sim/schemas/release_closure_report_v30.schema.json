        "release_id": {
          "default": "V30-DUPLICATE-DEFINITION-AND-DEAD-CODE-CLOSURE-1",
          "title": "Release Id",
          "type": "string"
        },
        "release_version": {
          "default": "0.3.0",
          "title": "Release Version",
          "type": "string"
        },
        "generated_at_utc": {
          "title": "Generated At Utc",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "strict_assets": {
          "title": "Strict Assets",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ReleaseCheck"
          },
