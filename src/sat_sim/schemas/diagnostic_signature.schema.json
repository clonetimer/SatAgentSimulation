{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.diagnostic-signature.v1",
  "type": "object",
  "required": [
    "schema_version",
    "signature_id",
    "fault_id",
    "source_experiment_template_id",
    "required_channels",
    "criteria",
    "qualification",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-sim.diagnostic-signature.v1"
    },
    "signature_id": {
      "type": "string",
      "minLength": 1
    },
    "fault_id": {
      "type": "string",
      "minLength": 1
    },
    "source_experiment_template_id": {
      "type": "string",
      "minLength": 1
    },
    "required_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "channel",
          "metric",
          "threshold",
          "evidence_role",
          "contributes_to_diagnostic_score"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "enum": [
              "post_fault_mean_minus_nominal_gt",
              "post_pair_max_abs_delta_gt",
              "post_pair_rms_delta_gt",
              "post_fault_max_le",
              "post_fault_to_nominal_mean_ratio_lt",
              "post_fault_fraction_le_gte",
              "post_pair_threshold_persistence_gte",
              "paired_delta_onset_latency_le"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "value_threshold": {
            "type": "number"
          },
          "absolute_delta_threshold": {
            "type": "number",
            "minimum": 0
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          },
          "evidence_role": {
            "enum": [
              "observable_telemetry",
              "operational_estimate",
              "simulator_truth"
            ]
          },
          "contributes_to_diagnostic_score": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "qualification": {
      "type": "object",
      "required": [
        "minimum_diagnostic_score",
        "threshold_status",
        "minimum_independent_basilisk_pairs_for_freeze",
        "minimum_observable_criteria_passed"
      ],
      "properties": {
        "minimum_diagnostic_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_all_required_criteria": {
          "type": "boolean"
        },
        "threshold_status": {
          "enum": [
            "provisional_until_basilisk_18_case",
            "frozen"
          ]
        },
        "minimum_independent_basilisk_pairs_for_freeze": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_observable_criteria_passed": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
