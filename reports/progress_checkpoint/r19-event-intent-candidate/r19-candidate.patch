+               rf'(?:(?:从|from)\s*{number}\s*[%％]\s*(?:改为|变为|调整为|更改为|to)\s*'
+               r'|(?:为|of|is|=)?\s*)'
+               rf'(?P<percent>{number})\s*[%％]')
+    matches = list(re.finditer(pattern, latest, re.I))
+    if len(matches) != 1:
+        return []
+    match = matches[0]
