{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.fault-severity-descriptor.v1",
  "type": "object",
  "required": [
    "schema_version",
    "fault_id",
    "normalized_severity",
    "severity_level",
    "mechanism_kind",
    "physically_applied",
    "model",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-sim.fault-severity-descriptor.v1"
    },
    "fault_id": {
      "type": "string",
      "minLength": 1
    },
    "normalized_severity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity_level": {
      "type": "string",
      "minLength": 1
    },
    "mechanism_kind": {
      "enum": [
        "continuous_degradation",
        "binary_failure"
      ]
    },
    "physically_applied": {
      "type": "boolean"
    },
    "simulator_parameter": {
      "type": [
        "string",
        "null"
      ]
    },
    "simulator_value": {
      "type": [
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "schema_version",
        "mechanism_kind",
        "bands"
      ],
      "properties": {
        "schema_version": {
          "const": "sat-sim.fault-severity-model.v1"
        },
        "mechanism_kind": {
          "enum": [
            "continuous_degradation",
            "binary_failure"
          ]
        },
        "fixed_normalized_severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "physical_parameter": {
          "type": "object",
          "required": [
            "name",
            "direction"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": [
                "increasing",
                "decreasing"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "mapping": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "level",
              "min_inclusive",
              "max_inclusive"
            ],
            "properties": {
              "level": {
                "type": "string",
                "minLength": 1
              },
              "min_inclusive": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max_inclusive": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mechanism_kind": {
                "const": "binary_failure"
              }
            }
          },
          "then": {
            "required": [
              "fixed_normalized_severity"
            ]
          },
          "else": {
            "required": [
              "physical_parameter"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
