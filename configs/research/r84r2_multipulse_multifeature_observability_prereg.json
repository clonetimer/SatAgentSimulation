  "frozen_multifeature_analysis": {
    "feature_family": [
      "aligned_mean_response_x/y/z",
      "mean_abs_pulse_mean_delta_x/y/z",
      "mean_rms_delta_x/y/z",
      "mean_std_delta_x/y/z",
      "mean_diff_rms_delta_x/y/z",
      "mean_vector_rms_delta"
    ],
    "aligned_mean_definition": "For each pulse, polarity_sign * (post_window_axis_mean - pre_window_axis_mean); average across all four pulses for each axis. Pulse polarity is fixed by the predeclared FSW reference schedule.",
    "absolute_mean_definition": "For each axis, average abs(post_window_axis_mean - pre_window_axis_mean) across four pulses.",
    "rms_definition": "For each axis and pulse, compute sqrt(mean(raw_gyro_axis^2)) in pre and post windows; average post-minus-pre across four pulses.",
    "std_definition": "For each axis and pulse, compute sample standard deviation in pre and post windows; average post-minus-pre across four pulses.",
    "diff_rms_definition": "For each axis and pulse, compute RMS(first_difference(raw_gyro_axis)/0.2s) in pre and post windows; average post-minus-pre across four pulses.",
    "vector_rms_definition": "For each pulse, compute sqrt(mean(gx^2+gy^2+gz^2)) in pre and post windows; average post-minus-pre across four pulses.",
    "robust_standardization": "For each physical context, use only the 30 healthy_calibration runs: median center and 1.4826*MAD scale per fixed feature; if MAD is zero use IQR/1.349; if still zero use 1e-12 floor.",
    "composite_score": "maximum absolute robust standardized deviation across the 16 frozen features",
    "threshold": "nearest-rank empirical 90th percentile of the 30 healthy_calibration composite scores",
    "threshold_application": "apply unchanged to 30 independent healthy_false_alarm_control, 30 loss50_primary and 30 loss75_primary runs in the same physical context",
    "sensitivity": "report composite-score and feature distributions, Cliff's delta and equal-size empirical Wasserstein-1 at low/high noise; do not transfer primary threshold",
    "required_summaries": [
      "independent healthy false-alarm count and rate",
      "loss50 and loss75 composite-score threshold exceedance count and rate",
      "per-context and pooled feature median/IQR/min/max",
      "per-context and pooled composite-score median/IQR/min/max",
      "Cliff's delta and Wasserstein-1 for composite score and each fixed feature",
      "pulse-to-pulse feature distributions"
    ],
    "no_posthoc_feature_selection": true,
    "no_threshold_tuning_after_fault_results": true,
    "no_classifier_training": true,
    "no_time_samples_as_independent_replicates": true
  },
