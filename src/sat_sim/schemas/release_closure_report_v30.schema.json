      "type": "object"
    },
    "ReleaseCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "reason_codes": {
          "items": {
            "type": "string"
