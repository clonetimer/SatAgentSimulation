          "title": "Dependency Alias"
        },
        "dependency_required": {
          "default": true,
          "title": "Dependency Required",
          "type": "boolean"
        },
        "depth": {
          "default": 0,
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        }
      },
      "required": [
        "capability_id",
        "role",
        "level",
        "owner",
        "public_adapter",
        "execution_mode"
