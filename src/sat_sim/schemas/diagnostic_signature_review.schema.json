{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.diagnostic-signature-review.v1",
  "type": "object",
  "required": ["schema_version", "fault_id", "decision", "reviewer_id", "reviewer_type", "reviewed_at_utc", "notes", "evidence_refs", "diagnostic_evidence_digest", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "sat-sim.diagnostic-signature-review.v1"},
    "fault_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["FREEZE", "REJECT"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_type": {"enum": ["human", "llm_assisted_human"]},
    "reviewed_at_utc": {"type": "string", "minLength": 1},
    "notes": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "reviewed_signature_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "diagnostic_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_boundary": {"type": "object"}
  },
  "additionalProperties": false
}
