{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sat-sim.fault-mechanism.v1",
  "type": "object",
  "required": [
    "schema_version",
    "mechanism_id",
    "fault_id",
    "subsystem",
    "component",
    "status",
    "causes",
    "physical_effects",
    "propagation_chain",
    "observables",
    "feature_contract_id",
    "pipeline_id",
    "knowledge_graph_projection",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-sim.fault-mechanism.v1"
    },
    "mechanism_id": {
      "type": "string",
      "minLength": 1
    },
    "fault_id": {
      "type": "string",
      "minLength": 1
    },
    "subsystem": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active_provisional",
        "blocked_pending_basilisk_fault_migration"
      ]
    },
    "diagnostic_signature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_id": {
      "type": "string",
      "minLength": 1
    },
    "causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cause_id",
          "kind",
          "description"
        ],
        "properties": {
          "cause_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "physical_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "effect_id",
          "description"
        ],
        "properties": {
          "effect_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "state_variable": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "propagation_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "channel",
          "evidence_role",
          "expected_relation",
          "model_input_eligible"
        ],
        "properties": {
          "channel": {
            "type": "string"
          },
          "evidence_role": {
            "enum": [
              "observable_telemetry",
              "operational_estimate",
              "simulator_truth"
            ]
          },
          "expected_relation": {
            "type": "string"
          },
          "model_input_eligible": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "knowledge_graph_projection": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
